<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record model="res.groups.privilege" id="res_groups_privilege_rn_hr_intel">
        <field name="name">ARMORA Workforce Intelligence</field>
        <field name="category_id" ref="base.module_category_human_resources"/>
    </record>
    <record id="group_rn_hr_intel_user" model="res.groups">
        <field name="name">HR Analyst</field>
        <field name="privilege_id" ref="res_groups_privilege_rn_hr_intel"/>
        <field name="implied_ids" eval="[(4, ref('hr.group_hr_user'))]"/>
    </record>
    <record id="group_rn_hr_intel_manager" model="res.groups">
        <field name="name">HR Intelligence Manager</field>
        <field name="privilege_id" ref="res_groups_privilege_rn_hr_intel"/>
        <field name="implied_ids" eval="[(4, ref('group_rn_hr_intel_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <record id="rule_rn_hr_payroll_snapshot_company" model="ir.rule">
        <field name="name">Payroll Snapshot multi-company</field>
        <field name="model_id" ref="model_rn_hr_payroll_snapshot"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_rn_hr_overtime_company" model="ir.rule">
        <field name="name">Overtime Log multi-company</field>
        <field name="model_id" ref="model_rn_hr_overtime_log"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_rn_hr_attrition_company" model="ir.rule">
        <field name="name">Attrition Record multi-company</field>
        <field name="model_id" ref="model_rn_hr_attrition_record"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_rn_hr_insight_company" model="ir.rule">
        <field name="name">HR Insight multi-company</field>
        <field name="model_id" ref="model_rn_hr_ai_insight"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_rn_hr_quality_company" model="ir.rule">
        <field name="name">Data Quality multi-company</field>
        <field name="model_id" ref="model_rn_hr_data_quality_check"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_rn_hr_intel_settings_company" model="ir.rule">
        <field name="name">HR Intelligence Settings multi-company</field>
        <field name="model_id" ref="model_rn_hr_intelligence_settings"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
