<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record model="res.groups.privilege" id="res_groups_privilege_rn_hotel">
        <field name="name">ARMORA Hotel ERP</field>
        <field name="category_id" ref="base.module_category_services"/>
    </record>
    <record id="group_rn_hotel_front" model="res.groups">
        <field name="name">Front Office</field>
        <field name="privilege_id" ref="res_groups_privilege_rn_hotel"/>
    </record>
    <record id="group_rn_hotel_housekeeping" model="res.groups">
        <field name="name">Housekeeping</field>
        <field name="privilege_id" ref="res_groups_privilege_rn_hotel"/>
        <field name="implied_ids" eval="[(4, ref('group_rn_hotel_front'))]"/>
    </record>
    <record id="group_rn_hotel_manager" model="res.groups">
        <field name="name">Hotel Manager</field>
        <field name="privilege_id" ref="res_groups_privilege_rn_hotel"/>
        <field name="implied_ids" eval="[(4, ref('group_rn_hotel_housekeeping'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>
    <record id="rule_rn_hotel_room_company" model="ir.rule">
        <field name="name">Hotel Room multi-company</field>
        <field name="model_id" ref="model_rn_hotel_room"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_rn_hotel_reservation_company" model="ir.rule">
        <field name="name">Reservation multi-company</field>
        <field name="model_id" ref="model_rn_hotel_reservation"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_rn_hotel_folio_company" model="ir.rule">
        <field name="name">Folio multi-company</field>
        <field name="model_id" ref="model_rn_hotel_folio"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_rn_hotel_settings_company" model="ir.rule">
        <field name="name">Hotel Settings multi-company</field>
        <field name="model_id" ref="model_rn_hotel_settings"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
