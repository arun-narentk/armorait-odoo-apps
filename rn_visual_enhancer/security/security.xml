<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record model="res.groups.privilege" id="res_groups_privilege_rn_color_tags">
        <field name="name">ARMORA Visual Enhancer</field>
        <field name="category_id" ref="base.module_category_productivity"/>
    </record>

    <record id="group_rn_color_tags_user" model="res.groups">
        <field name="name">User</field>
        <field name="privilege_id" ref="res_groups_privilege_rn_color_tags"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_rn_color_tags_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="privilege_id" ref="res_groups_privilege_rn_color_tags"/>
        <field name="implied_ids" eval="[(4, ref('group_rn_color_tags_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <record id="rule_rn_color_rule_company" model="ir.rule">
        <field name="name">Color rules multi-company</field>
        <field name="model_id" ref="model_rn_color_rule"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="rule_rn_visual_status_company" model="ir.rule">
        <field name="name">Visual status maps multi-company</field>
        <field name="model_id" ref="model_rn_visual_status"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
