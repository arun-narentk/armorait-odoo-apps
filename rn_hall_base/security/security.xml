<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record model="res.groups.privilege" id="res_groups_privilege_rn_hall">
        <field name="name">ARMORA Marriage Hall Management</field>
        <field name="category_id" ref="base.module_category_services"/>
    </record>
    <record id="group_rn_hall_readonly" model="res.groups">
        <field name="name">Readonly</field>
        <field name="privilege_id" ref="res_groups_privilege_rn_hall"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="group_rn_hall_counter" model="res.groups">
        <field name="name">Counter Staff</field>
        <field name="privilege_id" ref="res_groups_privilege_rn_hall"/>
        <field name="implied_ids" eval="[(4, ref('group_rn_hall_readonly'))]"/>
    </record>
    <record id="group_rn_hall_office" model="res.groups">
        <field name="name">Office Staff</field>
        <field name="privilege_id" ref="res_groups_privilege_rn_hall"/>
        <field name="implied_ids" eval="[(4, ref('group_rn_hall_counter'))]"/>
    </record>
    <record id="group_rn_hall_manager" model="res.groups">
        <field name="name">Hall Manager</field>
        <field name="privilege_id" ref="res_groups_privilege_rn_hall"/>
        <field name="implied_ids" eval="[(4, ref('group_rn_hall_office'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <record id="rule_rn_hall_venue_company" model="ir.rule">
        <field name="name">Hall Venue multi-company</field>
        <field name="model_id" ref="model_rn_hall_venue"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_rn_hall_hall_company" model="ir.rule">
        <field name="name">Hall multi-company</field>
        <field name="model_id" ref="model_rn_hall_hall"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_rn_hall_booking_company" model="ir.rule">
        <field name="name">Hall Booking multi-company</field>
        <field name="model_id" ref="model_rn_hall_booking"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_rn_hall_settings_company" model="ir.rule">
        <field name="name">Hall Settings multi-company</field>
        <field name="model_id" ref="model_rn_hall_settings"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_rn_hall_subscription_company" model="ir.rule">
        <field name="name">Hall Subscription multi-company</field>
        <field name="model_id" ref="model_rn_hall_subscription"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
