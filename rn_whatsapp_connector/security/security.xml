<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record model="res.groups.privilege" id="res_groups_privilege_rn_whatsapp">
        <field name="name">ARMORA WhatsApp</field>
        <field name="category_id" ref="base.module_category_marketing"/>
    </record>

    <record id="group_rn_whatsapp_readonly" model="res.groups">
        <field name="name">Readonly</field>
        <field name="privilege_id" ref="res_groups_privilege_rn_whatsapp"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_rn_whatsapp_user" model="res.groups">
        <field name="name">User</field>
        <field name="privilege_id" ref="res_groups_privilege_rn_whatsapp"/>
        <field name="implied_ids" eval="[(4, ref('group_rn_whatsapp_readonly'))]"/>
    </record>

    <record id="group_rn_whatsapp_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="privilege_id" ref="res_groups_privilege_rn_whatsapp"/>
        <field name="implied_ids" eval="[(4, ref('group_rn_whatsapp_user'))]"/>
    </record>

    <record id="group_rn_whatsapp_admin" model="res.groups">
        <field name="name">Administrator</field>
        <field name="privilege_id" ref="res_groups_privilege_rn_whatsapp"/>
        <field name="implied_ids" eval="[(4, ref('group_rn_whatsapp_manager'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <record id="rule_rn_whatsapp_account_company" model="ir.rule">
        <field name="name">WhatsApp Account: multi-company</field>
        <field name="model_id" ref="model_rn_whatsapp_account"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="rule_rn_whatsapp_message_company" model="ir.rule">
        <field name="name">WhatsApp Message: multi-company</field>
        <field name="model_id" ref="model_rn_whatsapp_message"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="rule_rn_whatsapp_template_company" model="ir.rule">
        <field name="name">WhatsApp Template: multi-company</field>
        <field name="model_id" ref="model_rn_whatsapp_template"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="rule_rn_whatsapp_webhook_company" model="ir.rule">
        <field name="name">WhatsApp Webhook: multi-company</field>
        <field name="model_id" ref="model_rn_whatsapp_webhook"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>


    <record id="rule_rn_whatsapp_automation_company" model="ir.rule">
        <field name="name">WhatsApp Automation: multi-company</field>
        <field name="model_id" ref="model_rn_whatsapp_automation_rule"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_rn_whatsapp_subscription_company" model="ir.rule">
        <field name="name">WhatsApp Subscription: multi-company</field>
        <field name="model_id" ref="model_rn_whatsapp_subscription"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>

