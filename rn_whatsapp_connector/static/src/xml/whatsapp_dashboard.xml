<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="rn_whatsapp_connector.Dashboard">
        <div class="o_rn_whatsapp_dashboard p-4">
            <h1 class="mb-4">WhatsApp Dashboard</h1>
            <div class="row g-3">
                <div class="col-md-3">
                    <div class="card shadow-sm border-0">
                        <div class="card-body">
                            <div class="text-muted">Today's Messages</div>
                            <div class="display-6" t-esc="state.today"/>
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="card shadow-sm border-0">
                        <div class="card-body">
                            <div class="text-muted">Delivered</div>
                            <div class="display-6 text-success" t-esc="state.delivered"/>
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="card shadow-sm border-0">
                        <div class="card-body">
                            <div class="text-muted">Failed</div>
                            <div class="display-6 text-danger" t-esc="state.failed"/>
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="card shadow-sm border-0">
                        <div class="card-body">
                            <div class="text-muted">Pending</div>
                            <div class="display-6 text-warning" t-esc="state.pending"/>
                        </div>
                    </div>
                </div>
            </div>
            <p class="text-muted mt-4">Phase 1 dashboard. Charts and provider health arrive in Phase 11.</p>
        </div>
    </t>

</templates>
