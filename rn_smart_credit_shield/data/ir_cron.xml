<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ir_cron_whatsapp_overdue" model="ir.cron">
        <field name="name">Smart Credit Shield: Overdue invoice WhatsApp reminder</field>
        <field name="model_id" ref="account.model_account_move"/>
        <field name="state">code</field>
        <field name="code">model._cron_whatsapp_overdue_reminder()</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
    </record>
    <record id="ir_cron_whatsapp_retry_failed" model="ir.cron">
        <field name="name">Smart Credit Shield: Retry failed WhatsApp notifications</field>
        <field name="model_id" ref="account.model_account_move"/>
        <field name="state">code</field>
        <field name="code">model._cron_whatsapp_retry_failed()</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">1</field>
        <field name="interval_type">hours</field>
    </record>
</odoo>
