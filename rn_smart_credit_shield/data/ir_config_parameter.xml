<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Credit risk score weights (total normalized to 100). -->
        <record id="param_credit_risk_weight_overdue" model="ir.config_parameter">
            <field name="key">rn_smart_credit_shield.credit_risk_weight_overdue_ratio</field>
            <field name="value">40</field>
        </record>
        <record id="param_credit_risk_weight_avg_delay" model="ir.config_parameter">
            <field name="key">rn_smart_credit_shield.credit_risk_weight_avg_delay</field>
            <field name="value">30</field>
        </record>
        <record id="param_credit_risk_weight_unpaid_count" model="ir.config_parameter">
            <field name="key">rn_smart_credit_shield.credit_risk_weight_unpaid_count</field>
            <field name="value">20</field>
        </record>
        <record id="param_credit_risk_weight_exposure" model="ir.config_parameter">
            <field name="key">rn_smart_credit_shield.credit_risk_weight_exposure</field>
            <field name="value">10</field>
        </record>
        <!-- Score thresholds for level (low < 30 < medium < 60 < high < 90 < critical). -->
        <record id="param_credit_risk_threshold_medium" model="ir.config_parameter">
            <field name="key">rn_smart_credit_shield.credit_risk_threshold_medium</field>
            <field name="value">30</field>
        </record>
        <record id="param_credit_risk_threshold_high" model="ir.config_parameter">
            <field name="key">rn_smart_credit_shield.credit_risk_threshold_high</field>
            <field name="value">60</field>
        </record>
        <record id="param_credit_risk_threshold_critical" model="ir.config_parameter">
            <field name="key">rn_smart_credit_shield.credit_risk_threshold_critical</field>
            <field name="value">90</field>
        </record>
        <record id="param_enable_auto_block" model="ir.config_parameter">
            <field name="key">rn_smart_credit_shield.enable_auto_block</field>
            <field name="value">True</field>
        </record>
        <record id="param_enable_whatsapp_automation" model="ir.config_parameter">
            <field name="key">rn_smart_credit_shield.enable_whatsapp_automation</field>
            <field name="value">True</field>
        </record>
    </data>
</odoo>
