<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_credit_override_wizard_form" model="ir.ui.view">
        <field name="name">credit.override.wizard.form</field>
        <field name="model">credit.override.wizard</field>
        <field name="arch" type="xml">
            <form string="Credit Override">
                <group>
                    <field name="order_id" readonly="1"/>
                    <field name="approval_by"/>
                    <field name="reason" placeholder="Reason for override and approval..."/>
                </group>
                <footer>
                    <button name="action_confirm_override" string="Confirm with Override" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
