<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="group_credit_controller" model="res.groups">
            <field name="name">Credit Controller</field>
            <field name="category_id" ref="base.module_category_accounting"/>
            <field name="comment">Can view credit dashboard, high-risk partners, overdue invoices, and WhatsApp log. Cannot override blocked SO.</field>
        </record>
        <record id="group_credit_manager" model="res.groups">
            <field name="name">Credit Manager</field>
            <field name="category_id" ref="base.module_category_accounting"/>
            <field name="implied_ids" eval="[(4, ref('rn_smart_credit_shield.group_credit_controller'))]"/>
            <field name="comment">Can override blocked sale orders (high/critical risk) and access credit violation log.</field>
        </record>
        <record id="group_finance_admin" model="res.groups">
            <field name="name">Finance Admin (Credit)</field>
            <field name="category_id" ref="base.module_category_accounting"/>
            <field name="implied_ids" eval="[(4, ref('rn_smart_credit_shield.group_credit_manager'))]"/>
            <field name="comment">Full access to credit settings (weights, thresholds, enable/disable automation).</field>
        </record>
    </data>
</odoo>
