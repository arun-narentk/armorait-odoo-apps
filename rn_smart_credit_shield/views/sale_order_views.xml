<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_credit_shield" model="ir.ui.view">
        <field name="name">sale.order.form.credit.shield</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <field name="partner_id" position="after">
                <field name="credit_blocked" invisible="1"/>
            </field>
            <div name="button_box" position="inside">
                <button name="action_credit_override" string="Credit Override" type="object" class="oe_highlight" groups="rn_smart_credit_shield.group_credit_manager" invisible="state not in ('draft', 'sent') or (not credit_blocked and partner_id.credit_risk_level not in ('high', 'critical'))"/>
            </div>
        </field>
    </record>
</odoo>
