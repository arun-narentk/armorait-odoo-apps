<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record model="res.groups.privilege" id="res_groups_privilege_rn_mrp_intel">
        <field name="name">ARMORA Manufacturing Intelligence</field>
        <field name="category_id" ref="base.module_category_manufacturing"/>
    </record>
    <record id="group_rn_mrp_intel_user" model="res.groups">
        <field name="name">Factory Viewer</field>
        <field name="privilege_id" ref="res_groups_privilege_rn_mrp_intel"/>
        <field name="implied_ids" eval="[(4, ref('mrp.group_mrp_user'))]"/>
    </record>
    <record id="group_rn_mrp_intel_manager" model="res.groups">
        <field name="name">Factory Manager</field>
        <field name="privilege_id" ref="res_groups_privilege_rn_mrp_intel"/>
        <field name="implied_ids" eval="[(4, ref('group_rn_mrp_intel_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <record id="rule_rn_mrp_shift_company" model="ir.rule">
        <field name="name">MRP Shift multi-company</field>
        <field name="model_id" ref="model_rn_mrp_shift"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_rn_mrp_downtime_company" model="ir.rule">
        <field name="name">Downtime Log multi-company</field>
        <field name="model_id" ref="model_rn_mrp_downtime_log"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_rn_mrp_oee_company" model="ir.rule">
        <field name="name">OEE Record multi-company</field>
        <field name="model_id" ref="model_rn_mrp_oee_record"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_rn_mrp_insight_company" model="ir.rule">
        <field name="name">AI Insight multi-company</field>
        <field name="model_id" ref="model_rn_mrp_ai_insight"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_rn_mrp_wc_status_company" model="ir.rule">
        <field name="name">Workcenter Status multi-company</field>
        <field name="model_id" ref="model_rn_mrp_workcenter_status"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_rn_mrp_intel_settings_company" model="ir.rule">
        <field name="name">Intelligence Settings multi-company</field>
        <field name="model_id" ref="model_rn_mrp_intelligence_settings"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
