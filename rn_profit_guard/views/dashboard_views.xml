<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_rn_profit_guard_dashboard_form" model="ir.ui.view">
        <field name="name">profit.guard.dashboard.form</field>
        <field name="model">profit.guard.dashboard</field>
        <field name="arch" type="xml">
            <form string="Inventory &amp; Margin Intelligence" create="0" delete="0">
                <sheet>
                    <group>
                        <group string="Dead Stock">
                            <field name="company_id" options="{'no_create': True}"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="total_dead_stock_value" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                            <field name="total_slow_stock_value" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                            <field name="total_capital_locked" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                        </group>
                        <group string="Margin">
                            <field name="margin_violations_count"/>
                        </group>
                    </group>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_dead_stock_products" type="action" class="oe_stat_button" icon="fa-exclamation-circle">
                            <field name="total_dead_stock_value" widget="statinfo" string="Dead Stock"/>
                        </button>
                        <button name="action_margin_violations" type="action" class="oe_stat_button" icon="fa-warning">
                            <field name="margin_violations_count" widget="statinfo" string="Violations"/>
                        </button>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_rn_profit_guard_dashboard" model="ir.actions.server">
        <field name="name">Inventory &amp; Margin Intelligence</field>
        <field name="model_id" ref="rn_profit_guard.model_profit_guard_dashboard"/>
        <field name="state">code</field>
        <field name="code">action = model.action_open_dashboard()</field>
    </record>

    <record id="action_dead_stock_products" model="ir.actions.act_window">
        <field name="name">Dead Stock Products</field>
        <field name="res_model">product.product</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('type', '=', 'product'), ('dead_stock_status', '=', 'dead')]</field>
        <field name="context">{'search_default_filter_to_sell': 1}</field>
    </record>

    <record id="action_slow_stock_products" model="ir.actions.act_window">
        <field name="name">Slow Moving Products</field>
        <field name="res_model">product.product</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('type', '=', 'product'), ('dead_stock_status', '=', 'slow')]</field>
        <field name="context">{'search_default_filter_to_sell': 1}</field>
    </record>

    <record id="action_margin_violations" model="ir.actions.act_window">
        <field name="name">Margin Violations</field>
        <field name="res_model">margin.violation.log</field>
        <field name="view_mode">list</field>
    </record>

    <record id="action_products_by_dead_stock" model="ir.actions.act_window">
        <field name="name">Products by Dead Stock Status</field>
        <field name="res_model">product.product</field>
        <field name="view_mode">graph,list</field>
        <field name="domain">[('type', '=', 'product'), ('dead_stock_status', '!=', False)]</field>
        <field name="context">{'search_default_filter_to_sell': 1}</field>
    </record>

    <menuitem id="menu_rn_profit_guard_root"
        name="Inventory &amp; Margin Intelligence"
        parent="stock.menu_stock_root"
        action="action_rn_profit_guard_dashboard"
        sequence="5"/>
    <menuitem id="menu_rn_profit_guard_dashboard"
        name="Dashboard"
        parent="rn_profit_guard.menu_rn_profit_guard_root"
        action="action_rn_profit_guard_dashboard"
        sequence="1"/>
    <menuitem id="menu_dead_stock"
        name="Dead Stock"
        parent="rn_profit_guard.menu_rn_profit_guard_root"
        action="rn_profit_guard.action_dead_stock_products"
        sequence="10"/>
    <menuitem id="menu_slow_stock"
        name="Slow Moving"
        parent="rn_profit_guard.menu_rn_profit_guard_root"
        action="rn_profit_guard.action_slow_stock_products"
        sequence="15"/>
    <menuitem id="menu_margin_violations"
        name="Margin Violations"
        parent="rn_profit_guard.menu_rn_profit_guard_root"
        action="rn_profit_guard.action_margin_violations"
        sequence="20"/>
</odoo>
