<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_margin_override_wizard_form" model="ir.ui.view">
        <field name="name">margin.override.wizard.form</field>
        <field name="model">margin.override.wizard</field>
        <field name="arch" type="xml">
            <form string="Margin Override">
                <group>
                    <field name="order_id" readonly="1"/>
                    <field name="approved_by_id"/>
                    <field name="reason" placeholder="Reason for override..."/>
                </group>
                <footer>
                    <button name="action_confirm_override" string="Confirm with Override" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
