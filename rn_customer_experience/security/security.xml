<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record model="res.groups.privilege" id="res_groups_privilege_rn_customer_experience">
        <field name="name">Customer Experience Portal</field>
        <field name="category_id" ref="base.module_category_website"/>
    </record>
    <record id="group_rn_customer_experience_user" model="res.groups">
        <field name="name">Portal Manager</field>
        <field name="privilege_id" ref="res_groups_privilege_rn_customer_experience"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="group_rn_customer_experience_admin" model="res.groups">
        <field name="name">Portal Administrator</field>
        <field name="privilege_id" ref="res_groups_privilege_rn_customer_experience"/>
        <field name="implied_ids" eval="[(4, ref('group_rn_customer_experience_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <record id="rule_rn_customer_experience_ticket_company" model="ir.rule">
        <field name="name">Experience Ticket multi-company</field>
        <field name="model_id" ref="model_rn_customer_experience_ticket"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_rn_customer_experience_ticket_portal" model="ir.rule">
        <field name="name">Portal users own tickets</field>
        <field name="model_id" ref="model_rn_customer_experience_ticket"/>
        <field name="domain_force">[('partner_id', 'child_of', user.partner_id.commercial_partner_id.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
    </record>
</odoo>
