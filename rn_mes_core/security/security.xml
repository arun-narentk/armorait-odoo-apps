<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record model="res.groups.privilege" id="res_groups_privilege_rn_mes">
        <field name="name">ARMORA Manufacturing MES</field>
        <field name="category_id" ref="base.module_category_manufacturing"/>
    </record>
    <record id="group_rn_mes_operator" model="res.groups">
        <field name="name">Shop Floor Operator</field>
        <field name="privilege_id" ref="res_groups_privilege_rn_mes"/>
        <field name="implied_ids" eval="[(4, ref('mrp.group_mrp_user'))]"/>
    </record>
    <record id="group_rn_mes_supervisor" model="res.groups">
        <field name="name">Production Supervisor</field>
        <field name="privilege_id" ref="res_groups_privilege_rn_mes"/>
        <field name="implied_ids" eval="[(4, ref('group_rn_mes_operator'))]"/>
    </record>
    <record id="group_rn_mes_manager" model="res.groups">
        <field name="name">MES Manager</field>
        <field name="privilege_id" ref="res_groups_privilege_rn_mes"/>
        <field name="implied_ids" eval="[(4, ref('group_rn_mes_supervisor'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <record id="rule_rn_mes_terminal_company" model="ir.rule">
        <field name="name">MES Terminal multi-company</field>
        <field name="model_id" ref="model_rn_mes_terminal"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
