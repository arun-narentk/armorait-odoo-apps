<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record model="res.groups.privilege" id="res_groups_privilege_rn_hospital">
        <field name="name">ARMORA Hospital ERP</field>
        <field name="category_id" ref="base.module_category_services"/>
    </record>
    <record id="group_rn_hospital_reception" model="res.groups">
        <field name="name">Reception / Front Desk</field>
        <field name="privilege_id" ref="res_groups_privilege_rn_hospital"/>
    </record>
    <record id="group_rn_hospital_nurse" model="res.groups">
        <field name="name">Nurse</field>
        <field name="privilege_id" ref="res_groups_privilege_rn_hospital"/>
        <field name="implied_ids" eval="[(4, ref('group_rn_hospital_reception'))]"/>
    </record>
    <record id="group_rn_hospital_doctor" model="res.groups">
        <field name="name">Doctor</field>
        <field name="privilege_id" ref="res_groups_privilege_rn_hospital"/>
        <field name="implied_ids" eval="[(4, ref('group_rn_hospital_nurse'))]"/>
    </record>
    <record id="group_rn_hospital_manager" model="res.groups">
        <field name="name">Hospital Manager</field>
        <field name="privilege_id" ref="res_groups_privilege_rn_hospital"/>
        <field name="implied_ids" eval="[(4, ref('group_rn_hospital_doctor'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <record id="rule_rn_hospital_patient_company" model="ir.rule">
        <field name="name">Patient multi-company</field>
        <field name="model_id" ref="model_rn_hospital_patient"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_rn_hospital_appointment_company" model="ir.rule">
        <field name="name">Appointment multi-company</field>
        <field name="model_id" ref="model_rn_hospital_appointment"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_rn_hospital_encounter_company" model="ir.rule">
        <field name="name">EMR Encounter multi-company</field>
        <field name="model_id" ref="model_rn_hospital_emr_encounter"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_rn_hospital_admission_company" model="ir.rule">
        <field name="name">Admission multi-company</field>
        <field name="model_id" ref="model_rn_hospital_admission"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_rn_hospital_billing_company" model="ir.rule">
        <field name="name">Billing Line multi-company</field>
        <field name="model_id" ref="model_rn_hospital_billing_line"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_rn_hospital_settings_company" model="ir.rule">
        <field name="name">Hospital Settings multi-company</field>
        <field name="model_id" ref="model_rn_hospital_settings"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
