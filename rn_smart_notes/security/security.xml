<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record model="res.groups.privilege" id="res_groups_privilege_rn_smart_notes">
        <field name="name">ARMORA Smart Notes</field>
        <field name="category_id" ref="base.module_category_productivity"/>
    </record>

    <record id="group_rn_smart_notes_user" model="res.groups">
        <field name="name">User</field>
        <field name="privilege_id" ref="res_groups_privilege_rn_smart_notes"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_rn_smart_notes_sales_team" model="res.groups">
        <field name="name">Sales Team Notes</field>
        <field name="privilege_id" ref="res_groups_privilege_rn_smart_notes"/>
        <field name="implied_ids" eval="[(4, ref('group_rn_smart_notes_user')), (4, ref('sales_team.group_sale_salesman'))]"/>
    </record>

    <record id="group_rn_smart_notes_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="privilege_id" ref="res_groups_privilege_rn_smart_notes"/>
        <field name="implied_ids" eval="[(4, ref('group_rn_smart_notes_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <record id="rule_rn_smart_note_company" model="ir.rule">
        <field name="name">Smart Note multi-company</field>
        <field name="model_id" ref="model_rn_smart_note"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="rule_rn_smart_note_user_visibility" model="ir.rule">
        <field name="name">Smart Note user visibility</field>
        <field name="model_id" ref="model_rn_smart_note"/>
        <field name="groups" eval="[(4, ref('group_rn_smart_notes_user'))]"/>
        <field name="domain_force">[
            '|', '|', '|',
            ('visibility', '=', 'everyone'),
            ('user_id', '=', user.id),
            ('mention_user_ids', 'in', user.id),
            '&amp;', ('visibility', '=', 'only_me'), ('user_id', '=', user.id)
        ]</field>
    </record>

    <record id="rule_rn_smart_note_sales_team_visibility" model="ir.rule">
        <field name="name">Smart Note sales team visibility</field>
        <field name="model_id" ref="model_rn_smart_note"/>
        <field name="groups" eval="[(4, ref('group_rn_smart_notes_sales_team'))]"/>
        <field name="domain_force">[('visibility', '=', 'sales_team')]</field>
    </record>

    <record id="rule_rn_smart_note_manager_all" model="ir.rule">
        <field name="name">Smart Note manager access</field>
        <field name="model_id" ref="model_rn_smart_note"/>
        <field name="groups" eval="[(4, ref('group_rn_smart_notes_manager'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>

    <record id="rule_rn_smart_note_template_company" model="ir.rule">
        <field name="name">Smart Note Template multi-company</field>
        <field name="model_id" ref="model_rn_smart_note_template"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
