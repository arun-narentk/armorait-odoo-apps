<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record model="res.groups.privilege" id="res_groups_privilege_rn_dup_finder">
        <field name="name">ARMORA Duplicate Finder</field>
        <field name="category_id" ref="base.module_category_productivity"/>
    </record>
    <record id="group_rn_dup_finder_user" model="res.groups">
        <field name="name">User</field>
        <field name="privilege_id" ref="res_groups_privilege_rn_dup_finder"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="group_rn_dup_finder_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="privilege_id" ref="res_groups_privilege_rn_dup_finder"/>
        <field name="implied_ids" eval="[(4, ref('group_rn_dup_finder_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>
    <record id="rule_rn_dup_rule_company" model="ir.rule">
        <field name="name">Duplicate Rule multi-company</field>
        <field name="model_id" ref="model_rn_dup_rule"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_rn_dup_scan_company" model="ir.rule">
        <field name="name">Duplicate Scan multi-company</field>
        <field name="model_id" ref="model_rn_dup_scan"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_rn_dup_result_company" model="ir.rule">
        <field name="name">Duplicate Result multi-company</field>
        <field name="model_id" ref="model_rn_dup_result"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_rn_dup_ignore_company" model="ir.rule">
        <field name="name">Duplicate Ignore multi-company</field>
        <field name="model_id" ref="model_rn_dup_ignore"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
