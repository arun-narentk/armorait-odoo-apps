<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record model="res.groups.privilege" id="res_groups_privilege_rn_erp_health_analyzer">
        <field name="name">ERP Health Analyzer</field>
        <field name="category_id" ref="base.module_category_productivity"/>
    </record>

    <record id="group_rn_erp_health_analyzer_user" model="res.groups">
        <field name="name">ERP Health Analyst</field>
        <field name="privilege_id" ref="res_groups_privilege_rn_erp_health_analyzer"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_rn_erp_health_analyzer_manager" model="res.groups">
        <field name="name">ERP Health Manager</field>
        <field name="privilege_id" ref="res_groups_privilege_rn_erp_health_analyzer"/>
        <field name="implied_ids" eval="[(4, ref('group_rn_erp_health_analyzer_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <record id="rule_rn_erp_health_target_company" model="ir.rule">
        <field name="name">ERP Health target multi-company</field>
        <field name="model_id" ref="model_rn_erp_health_target"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="rule_rn_erp_health_scan_company" model="ir.rule">
        <field name="name">ERP Health scan multi-company</field>
        <field name="model_id" ref="model_rn_erp_health_scan"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="rule_rn_erp_health_finding_company" model="ir.rule">
        <field name="name">ERP Health finding multi-company</field>
        <field name="model_id" ref="model_rn_erp_health_finding"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
