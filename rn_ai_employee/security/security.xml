<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record model="res.groups.privilege" id="res_groups_privilege_rn_ai_employee">
        <field name="name">AI Copilot</field>
        <field name="sequence">25</field>
        <field name="category_id" ref="base.module_category_productivity"/>
    </record>

    <record id="group_rn_ai_employee_user" model="res.groups">
        <field name="name">User</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_rn_ai_employee"/>
        <field name="comment">Ask business questions and view own AI Copilot conversations.</field>
    </record>

    <record id="group_rn_ai_employee_manager" model="res.groups">
        <field name="name">Administrator</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_rn_ai_employee"/>
        <field name="implied_ids" eval="[(4, ref('group_rn_ai_employee_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        <field name="comment">Manage AI Copilot tools, suggestions, and all conversations.</field>
    </record>

    <record id="base.group_user" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_rn_ai_employee_user'))]"/>
    </record>

    <record id="rule_rn_ai_employee_chat_user" model="ir.rule">
        <field name="name">AI Copilot Chat: own conversations</field>
        <field name="model_id" ref="model_rn_ai_employee_chat"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_rn_ai_employee_user'))]"/>
    </record>

    <record id="rule_rn_ai_employee_chat_manager" model="ir.rule">
        <field name="name">AI Copilot Chat: manager sees all</field>
        <field name="model_id" ref="model_rn_ai_employee_chat"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_rn_ai_employee_manager'))]"/>
    </record>

    <record id="rule_rn_ai_employee_message_user" model="ir.rule">
        <field name="name">AI Copilot Message: own conversations</field>
        <field name="model_id" ref="model_rn_ai_employee_message"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_rn_ai_employee_user'))]"/>
    </record>

    <record id="rule_rn_ai_employee_message_manager" model="ir.rule">
        <field name="name">AI Copilot Message: manager sees all</field>
        <field name="model_id" ref="model_rn_ai_employee_message"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_rn_ai_employee_manager'))]"/>
    </record>
</odoo>
