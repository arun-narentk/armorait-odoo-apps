<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record model="res.groups.privilege" id="res_groups_privilege_rn_fleet_gps">
        <field name="name">ARMORA Fleet GPS</field>
        <field name="category_id" ref="base.module_category_human_resources"/>
    </record>
    <record id="group_rn_fleet_gps_readonly" model="res.groups">
        <field name="name">Readonly</field>
        <field name="privilege_id" ref="res_groups_privilege_rn_fleet_gps"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="group_rn_fleet_gps_user" model="res.groups">
        <field name="name">User</field>
        <field name="privilege_id" ref="res_groups_privilege_rn_fleet_gps"/>
        <field name="implied_ids" eval="[(4, ref('group_rn_fleet_gps_readonly'))]"/>
    </record>
    <record id="group_rn_fleet_gps_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="privilege_id" ref="res_groups_privilege_rn_fleet_gps"/>
        <field name="implied_ids" eval="[(4, ref('group_rn_fleet_gps_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <record id="rule_rn_fleet_device_company" model="ir.rule">
        <field name="name">GPS Device multi-company</field>
        <field name="model_id" ref="model_rn_fleet_gps_device"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_rn_fleet_location_company" model="ir.rule">
        <field name="name">GPS Location multi-company</field>
        <field name="model_id" ref="model_rn_fleet_gps_location"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_rn_fleet_trip_company" model="ir.rule">
        <field name="name">Fleet Trip multi-company</field>
        <field name="model_id" ref="model_rn_fleet_trip"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_rn_fleet_geofence_company" model="ir.rule">
        <field name="name">Geofence multi-company</field>
        <field name="model_id" ref="model_rn_fleet_geofence"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_rn_fleet_alert_company" model="ir.rule">
        <field name="name">Fleet Alert multi-company</field>
        <field name="model_id" ref="model_rn_fleet_alert"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_rn_fleet_driver_company" model="ir.rule">
        <field name="name">Driver Assignment multi-company</field>
        <field name="model_id" ref="model_rn_fleet_driver_assignment"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_rn_fleet_fuel_company" model="ir.rule">
        <field name="name">Fuel Log multi-company</field>
        <field name="model_id" ref="model_rn_fleet_fuel_log"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_rn_fleet_expense_company" model="ir.rule">
        <field name="name">Expense Log multi-company</field>
        <field name="model_id" ref="model_rn_fleet_expense_log"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_rn_fleet_settings_company" model="ir.rule">
        <field name="name">Fleet Settings multi-company</field>
        <field name="model_id" ref="model_rn_fleet_settings"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_rn_fleet_subscription_company" model="ir.rule">
        <field name="name">Fleet Subscription multi-company</field>
        <field name="model_id" ref="model_rn_fleet_subscription"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
