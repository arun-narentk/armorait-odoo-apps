<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record model="res.groups.privilege" id="res_groups_privilege_rn_universal_qr">
        <field name="name">Universal QR</field>
        <field name="category_id" ref="base.module_category_productivity"/>
    </record>

    <record id="group_rn_universal_qr_user" model="res.groups">
        <field name="name">Universal QR User</field>
        <field name="privilege_id" ref="res_groups_privilege_rn_universal_qr"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_rn_universal_qr_manager" model="res.groups">
        <field name="name">Universal QR Manager</field>
        <field name="privilege_id" ref="res_groups_privilege_rn_universal_qr"/>
        <field name="implied_ids" eval="[(4, ref('group_rn_universal_qr_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <record id="rule_rn_qr_record_company" model="ir.rule">
        <field name="name">QR Record multi-company</field>
        <field name="model_id" ref="model_rn_qr_record"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="rule_rn_qr_scan_log_company" model="ir.rule">
        <field name="name">QR Scan Log multi-company</field>
        <field name="model_id" ref="model_rn_qr_scan_log"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="rule_rn_qr_model_config_company" model="ir.rule">
        <field name="name">QR Model Config multi-company</field>
        <field name="model_id" ref="model_rn_qr_model_config"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
