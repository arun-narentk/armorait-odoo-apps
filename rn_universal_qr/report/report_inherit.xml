<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_saleorder_document_inherit_rn_qr" inherit_id="sale.report_saleorder_document">
        <xpath expr="//div[@id='total']" position="before">
            <div t-if="doc.rn_qr_image" class="mb-3">
                <img t-att-src="image_data_uri(doc.rn_qr_image)" style="max-height:120px;"/>
            </div>
        </xpath>
    </template>

    <template id="report_purchaseorder_document_inherit_rn_qr" inherit_id="purchase.report_purchaseorder_document">
        <xpath expr="//div[contains(@class, 'page')]" position="inside">
            <div t-if="o.rn_qr_image" class="mb-3">
                <img t-att-src="image_data_uri(o.rn_qr_image)" style="max-height:120px;"/>
            </div>
        </xpath>
    </template>

    <template id="report_invoice_document_inherit_rn_qr" inherit_id="account.report_invoice_document">
        <xpath expr="//div[contains(@class, 'page')]" position="inside">
            <div t-if="o.rn_qr_image" class="mb-3">
                <img t-att-src="image_data_uri(o.rn_qr_image)" style="max-height:120px;"/>
            </div>
        </xpath>
    </template>

    <template id="report_delivery_document_inherit_rn_qr" inherit_id="stock.report_delivery_document">
        <xpath expr="//div[contains(@class, 'page')]" position="inside">
            <div t-if="o.rn_qr_image" class="mb-3">
                <img t-att-src="image_data_uri(o.rn_qr_image)" style="max-height:120px;"/>
            </div>
        </xpath>
    </template>
</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_saleorder_document_qr" inherit_id="sale.report_saleorder_document">
        <xpath expr="//div[@class='page']" position="inside">
            <t t-set="qr_record" t-value="doc.env['rn.qr.record'].search([('res_model', '=', doc._name), ('res_id', '=', doc.id), ('active', '=', True)], limit=1)"/>
            <div t-if="qr_record and qr_record.qr_image" class="text-end mt-3">
                <strong>Scan QR</strong><br/>
                <img t-att-src="'data:image/png;base64,%s' % qr_record.qr_image" style="width:90px;height:90px;"/>
            </div>
        </xpath>
    </template>

