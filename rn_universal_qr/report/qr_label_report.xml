<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="paperformat_rn_qr_label" model="report.paperformat">
        <field name="name">Universal QR Label</field>
        <field name="default" eval="False"/>
        <field name="format">A4</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">10</field>
        <field name="margin_bottom">10</field>
        <field name="margin_left">8</field>
        <field name="margin_right">8</field>
    </record>

    <record id="action_report_rn_qr_label" model="ir.actions.report">
        <field name="name">QR Label</field>
        <field name="model">rn.qr.record</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">rn_universal_qr.report_rn_qr_label</field>
        <field name="report_file">rn_universal_qr.report_rn_qr_label</field>
        <field name="binding_model_id" ref="model_rn_qr_record"/>
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="paperformat_rn_qr_label"/>
    </record>

    <record id="action_report_rn_qr_a4" model="ir.actions.report">
        <field name="name">QR A4 Sheet</field>
        <field name="model">rn.qr.record</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">rn_universal_qr.report_rn_qr_a4</field>
        <field name="report_file">rn_universal_qr.report_rn_qr_a4</field>
        <field name="binding_model_id" ref="model_rn_qr_record"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_rn_qr_label">
        <t t-call="web.external_layout">
            <div class="page">
                <t t-foreach="docs" t-as="o">
                    <div class="mb-4 p-2 border">
                        <h4 t-out="o.name"/>
                        <p>
                            <strong>Model:</strong> <span t-out="o.res_model"/>
                            <strong class="ms-2">ID:</strong> <span t-out="o.res_id"/>
                        </p>
                        <img t-if="o.qr_image" t-att-src="image_data_uri(o.qr_image)" style="max-height:160px;"/>
                    </div>
                </t>
            </div>
        </t>
    </template>

    <template id="report_rn_qr_a4">
        <t t-call="web.external_layout">
            <div class="page">
                <h3>Universal QR A4 Sheet</h3>
                <div class="row">
                    <t t-foreach="docs" t-as="o">
                        <div class="col-4 mb-4">
                            <div class="text-center border p-2">
                                <div><strong t-out="o.name"/></div>
                                <img t-if="o.qr_image" t-att-src="image_data_uri(o.qr_image)" style="max-width:100%;max-height:120px;"/>
                            </div>
                        </div>
                    </t>
                </div>
            </div>
        </t>
    </template>
</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_report_qr_label" model="ir.actions.report">
        <field name="name">QR Label</field>
        <field name="model">rn.qr.record</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">rn_universal_qr.report_qr_label</field>
        <field name="report_file">rn_universal_qr.report_qr_label</field>
        <field name="print_report_name">'QR_Label_%s' % (object.res_name or object.token)</field>
    </record>

    <record id="action_report_qr_a4" model="ir.actions.report">
        <field name="name">QR A4 Sheet</field>
        <field name="model">rn.qr.record</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">rn_universal_qr.report_qr_a4</field>
        <field name="report_file">rn_universal_qr.report_qr_a4</field>
        <field name="print_report_name">'QR_A4_%s' % (object.res_name or object.token)</field>
    </record>

    <template id="report_qr_label">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <div class="page" style="text-align:center; padding: 8px;">
                    <img t-if="doc.qr_image"
                         t-att-src="'data:image/png;base64,%s' % doc.qr_image"
                         style="width:120px;height:120px;"/>
                    <div style="font-size:12px; margin-top:4px;">
                        <span t-esc="doc.res_name"/>
                    </div>
                    <div style="font-size:9px; word-break:break-all;">
                        <span t-esc="doc.qr_url"/>
                    </div>
                </div>
            </t>
        </t>
    </template>

    <template id="report_qr_a4">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <div class="page" style="text-align:center; padding: 40px;">
                    <h2>QR Code</h2>
                    <img t-if="doc.qr_image"
                         t-att-src="'data:image/png;base64,%s' % doc.qr_image"
                         style="width:240px;height:240px;"/>
                    <p><strong t-esc="doc.res_name"/></p>
                    <p t-esc="doc.qr_url"/>
                    <p>Scans: <span t-esc="doc.scan_count"/></p>
                </div>
            </t>
        </t>
    </template>
</odoo>
