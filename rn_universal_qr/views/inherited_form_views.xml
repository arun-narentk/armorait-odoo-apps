<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="rn_qr_form_section">
        <group string="QR Code" name="rn_qr_group" groups="rn_universal_qr.group_rn_universal_qr_user">
            <field name="rn_qr_active_id" invisible="1"/>
            <group>
                <field name="rn_qr_image" widget="image" class="oe_avatar" invisible="not rn_qr_active_id"/>
                <field name="rn_qr_url" widget="url" invisible="not rn_qr_active_id"/>
                <field name="rn_qr_scan_count" invisible="not rn_qr_active_id"/>
                <field name="rn_qr_last_scan" invisible="not rn_qr_active_id"/>
            </group>
            <group>
                <button name="action_generate_qr" type="object" string="Generate" class="btn-primary"
                        invisible="rn_qr_active_id"/>
                <button name="action_regenerate_qr" type="object" string="Regenerate"
                        invisible="not rn_qr_active_id"/>
                <button name="action_download_qr_png" type="object" string="Download PNG"
                        invisible="not rn_qr_active_id"/>
                <button name="action_download_qr_svg" type="object" string="Download SVG"
                        invisible="not rn_qr_active_id"/>
                <button name="action_print_qr_label" type="object" string="Print Label"
                        invisible="not rn_qr_active_id"/>
                <button name="action_print_qr_a4" type="object" string="Print A4"
                        invisible="not rn_qr_active_id"/>
            </group>
        </group>
    </template>

    <record id="view_order_form_rn_qr" model="ir.ui.view">
        <field name="name">sale.order.form.rn.qr</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_qr_records" type="object" class="oe_stat_button" icon="fa-qrcode"
                        groups="rn_universal_qr.group_rn_universal_qr_user">
                    <field name="rn_qr_count" widget="statinfo" string="QR"/>
                </button>
            </xpath>
            <xpath expr="//sheet/notebook" position="inside">
                <page string="QR Code" groups="rn_universal_qr.group_rn_universal_qr_user">
                    <group>
                        <field name="rn_qr_active_id" invisible="1"/>
                        <field name="rn_qr_image" widget="image" class="oe_avatar" invisible="not rn_qr_active_id"/>
                        <field name="rn_qr_url" widget="url" invisible="not rn_qr_active_id"/>
                        <field name="rn_qr_scan_count" invisible="not rn_qr_active_id"/>
                        <field name="rn_qr_last_scan" invisible="not rn_qr_active_id"/>
                    </group>
                    <group>
                        <button name="action_generate_qr" type="object" string="Generate" class="btn-primary"
                                invisible="rn_qr_active_id"/>
                        <button name="action_regenerate_qr" type="object" string="Regenerate"
                                invisible="not rn_qr_active_id"/>
                        <button name="action_download_qr_png" type="object" string="Download PNG"
                                invisible="not rn_qr_active_id"/>
                        <button name="action_download_qr_svg" type="object" string="Download SVG"
                                invisible="not rn_qr_active_id"/>
                        <button name="action_print_qr_label" type="object" string="Print Label"
                                invisible="not rn_qr_active_id"/>
                        <button name="action_print_qr_a4" type="object" string="Print A4"
                                invisible="not rn_qr_active_id"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <record id="view_purchase_order_form_rn_qr" model="ir.ui.view">
        <field name="name">purchase.order.form.rn.qr</field>
