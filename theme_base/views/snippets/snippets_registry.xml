<?xml version="1.0" encoding="utf-8"?>
<odoo>

<template id="snippets_registry" inherit_id="website.snippets" name="ARMORAIT Theme Base Snippets">
    <xpath expr="//t[@id='installed_snippets_hook']" position="after">
        <t snippet-group="theme_base" t-snippet="website.s_snippet_group" string="ARMORAIT"
            t-thumbnail="/website/static/src/img/snippets_thumbs/s_three_columns.svg"/>
    </xpath>
    <xpath expr="//snippets[@id='snippet_structure']" position="inside">
        <t t-snippet="theme_base.s_tb_hero_banner" string="Hero Banner" group="theme_base"/>
