<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record model="res.groups.privilege" id="res_groups_privilege_rn_record_share">
        <field name="name">ARMORA Record Share</field>
        <field name="category_id" ref="base.module_category_productivity"/>
    </record>
    <record id="group_rn_record_share_user" model="res.groups">
        <field name="name">User</field>
        <field name="privilege_id" ref="res_groups_privilege_rn_record_share"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="group_rn_record_share_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="privilege_id" ref="res_groups_privilege_rn_record_share"/>
        <field name="implied_ids" eval="[(4, ref('group_rn_record_share_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>
    <record id="rule_rn_share_log_user" model="ir.rule">
        <field name="name">Share log per user</field>
        <field name="model_id" ref="model_rn_share_log"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_rn_record_share_user'))]"/>
    </record>
</odoo>
