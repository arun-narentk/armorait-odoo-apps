<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record model="res.groups.privilege" id="res_groups_privilege_rn_workflow">
        <field name="name">ARMORA Workflow Builder</field>
        <field name="category_id" ref="base.module_category_productivity"/>
    </record>
    <record id="group_rn_workflow_user" model="res.groups">
        <field name="name">Workflow User</field>
        <field name="privilege_id" ref="res_groups_privilege_rn_workflow"/>
    </record>
    <record id="group_rn_workflow_designer" model="res.groups">
        <field name="name">Workflow Designer</field>
        <field name="privilege_id" ref="res_groups_privilege_rn_workflow"/>
        <field name="implied_ids" eval="[(4, ref('group_rn_workflow_user'))]"/>
    </record>
    <record id="group_rn_workflow_manager" model="res.groups">
        <field name="name">Workflow Manager</field>
        <field name="privilege_id" ref="res_groups_privilege_rn_workflow"/>
        <field name="implied_ids" eval="[(4, ref('group_rn_workflow_designer'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <record id="rule_rn_workflow_company" model="ir.rule">
        <field name="name">Workflow multi-company</field>
        <field name="model_id" ref="model_rn_workflow"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_rn_workflow_node_company" model="ir.rule">
        <field name="name">Workflow Node multi-company</field>
        <field name="model_id" ref="model_rn_workflow_node"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_rn_workflow_run_company" model="ir.rule">
        <field name="name">Workflow Run multi-company</field>
        <field name="model_id" ref="model_rn_workflow_run"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_rn_workflow_run_log_company" model="ir.rule">
        <field name="name">Workflow Run Log multi-company</field>
        <field name="model_id" ref="model_rn_workflow_run_log"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_rn_workflow_settings_company" model="ir.rule">
        <field name="name">Workflow Settings multi-company</field>
        <field name="model_id" ref="model_rn_workflow_settings"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
