<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record model="res.groups.privilege" id="res_groups_privilege_rn_school">
        <field name="name">ARMORA School OS</field>
        <field name="category_id" ref="base.module_category_services"/>
    </record>
    <record id="group_rn_school_staff" model="res.groups">
        <field name="name">School Staff</field>
        <field name="privilege_id" ref="res_groups_privilege_rn_school"/>
    </record>
    <record id="group_rn_school_teacher" model="res.groups">
        <field name="name">Teacher</field>
        <field name="privilege_id" ref="res_groups_privilege_rn_school"/>
        <field name="implied_ids" eval="[(4, ref('group_rn_school_staff'))]"/>
    </record>
    <record id="group_rn_school_admin" model="res.groups">
        <field name="name">School Administrator</field>
        <field name="privilege_id" ref="res_groups_privilege_rn_school"/>
        <field name="implied_ids" eval="[(4, ref('group_rn_school_teacher'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>
    <record id="rule_rn_school_student_company" model="ir.rule">
        <field name="name">Student multi-company</field>
        <field name="model_id" ref="model_rn_school_student"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_rn_school_class_company" model="ir.rule">
        <field name="name">Class multi-company</field>
        <field name="model_id" ref="model_rn_school_class"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_rn_school_admission_company" model="ir.rule">
        <field name="name">Admission multi-company</field>
        <field name="model_id" ref="model_rn_school_admission_application"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_rn_school_fee_company" model="ir.rule">
        <field name="name">Fee Installment multi-company</field>
        <field name="model_id" ref="model_rn_school_fee_installment"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_rn_school_settings_company" model="ir.rule">
        <field name="name">School Settings multi-company</field>
        <field name="model_id" ref="model_rn_school_settings"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
