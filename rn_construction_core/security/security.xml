<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record model="res.groups.privilege" id="res_groups_privilege_rn_construction">
        <field name="name">ARMORA Construction ERP</field>
        <field name="category_id" ref="base.module_category_services"/>
    </record>
    <record id="group_rn_construction_site_engineer" model="res.groups">
        <field name="name">Site Engineer</field>
        <field name="privilege_id" ref="res_groups_privilege_rn_construction"/>
    </record>
    <record id="group_rn_construction_pm" model="res.groups">
        <field name="name">Project Manager</field>
        <field name="privilege_id" ref="res_groups_privilege_rn_construction"/>
        <field name="implied_ids" eval="[(4, ref('group_rn_construction_site_engineer'))]"/>
    </record>
    <record id="group_rn_construction_manager" model="res.groups">
        <field name="name">Construction Manager</field>
        <field name="privilege_id" ref="res_groups_privilege_rn_construction"/>
        <field name="implied_ids" eval="[(4, ref('group_rn_construction_pm'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>
    <record id="rule_rn_construction_project_company" model="ir.rule">
        <field name="name">Construction Project multi-company</field>
        <field name="model_id" ref="model_rn_construction_project"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_rn_construction_site_company" model="ir.rule">
        <field name="name">Construction Site multi-company</field>
        <field name="model_id" ref="model_rn_construction_site"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_rn_construction_boq_company" model="ir.rule">
        <field name="name">BOQ multi-company</field>
        <field name="model_id" ref="model_rn_construction_boq"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_rn_construction_settings_company" model="ir.rule">
        <field name="name">Construction Settings multi-company</field>
        <field name="model_id" ref="model_rn_construction_settings"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_rn_construction_material_request_company" model="ir.rule">
        <field name="name">Material Request multi-company</field>
        <field name="model_id" ref="model_rn_construction_material_request"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_rn_construction_running_bill_company" model="ir.rule">
        <field name="name">Running Bill multi-company</field>
        <field name="model_id" ref="model_rn_construction_running_bill"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
