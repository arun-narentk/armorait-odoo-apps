<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record model="res.groups.privilege" id="res_groups_privilege_rn_dental">
        <field name="name">ARMORA Dental ERP</field>
        <field name="category_id" ref="base.module_category_services"/>
    </record>
    <record id="group_rn_dental_reception" model="res.groups">
        <field name="name">Reception</field>
        <field name="privilege_id" ref="res_groups_privilege_rn_dental"/>
    </record>
    <record id="group_rn_dental_dentist" model="res.groups">
        <field name="name">Dentist</field>
        <field name="privilege_id" ref="res_groups_privilege_rn_dental"/>
        <field name="implied_ids" eval="[(4, ref('group_rn_dental_reception'))]"/>
    </record>
    <record id="group_rn_dental_manager" model="res.groups">
        <field name="name">Clinic Manager</field>
        <field name="privilege_id" ref="res_groups_privilege_rn_dental"/>
        <field name="implied_ids" eval="[(4, ref('group_rn_dental_dentist'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>
    <record id="rule_rn_dental_patient_company" model="ir.rule">
        <field name="name">Patient multi-company</field>
        <field name="model_id" ref="model_rn_dental_patient"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_rn_dental_appointment_company" model="ir.rule">
        <field name="name">Appointment multi-company</field>
        <field name="model_id" ref="model_rn_dental_appointment"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_rn_dental_treatment_plan_company" model="ir.rule">
        <field name="name">Treatment Plan multi-company</field>
        <field name="model_id" ref="model_rn_dental_treatment_plan"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_rn_dental_settings_company" model="ir.rule">
        <field name="name">Dental Settings multi-company</field>
        <field name="model_id" ref="model_rn_dental_settings"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
