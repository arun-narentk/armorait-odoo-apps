<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record model="res.groups.privilege" id="res_groups_privilege_rn_dashboard_kpi">
        <field name="name">Dashboard KPI Studio</field>
        <field name="category_id" ref="base.module_category_productivity"/>
    </record>

    <record id="group_rn_dashboard_kpi_user" model="res.groups">
        <field name="name">User</field>
        <field name="privilege_id" ref="res_groups_privilege_rn_dashboard_kpi"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_rn_dashboard_kpi_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="privilege_id" ref="res_groups_privilege_rn_dashboard_kpi"/>
        <field name="implied_ids" eval="[(4, ref('group_rn_dashboard_kpi_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <!-- Users see own, public, or group-shared dashboards. Managers see all in allowed companies. -->
    <record id="rule_rn_kpi_dashboard_user" model="ir.rule">
        <field name="name">KPI Dashboard: user visibility</field>
        <field name="model_id" ref="model_rn_kpi_dashboard"/>
        <field name="domain_force">[
            '|', '|', '|',
            ('user_id', '=', user.id),
            ('is_public', '=', True),
            ('group_ids', 'in', user.all_group_ids.ids),
            ('create_uid', '=', user.id)
        ]</field>
        <field name="groups" eval="[(4, ref('group_rn_dashboard_kpi_user'))]"/>
    </record>

    <record id="rule_rn_kpi_dashboard_manager" model="ir.rule">
        <field name="name">KPI Dashboard: manager all</field>
        <field name="model_id" ref="model_rn_kpi_dashboard"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_rn_dashboard_kpi_manager'))]"/>
    </record>

    <record id="rule_rn_kpi_dashboard_company" model="ir.rule">
        <field name="name">KPI Dashboard multi-company</field>
        <field name="model_id" ref="model_rn_kpi_dashboard"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>

    <record id="rule_rn_kpi_dashboard_item_company" model="ir.rule">
        <field name="name">KPI Dashboard Item multi-company</field>
        <field name="model_id" ref="model_rn_kpi_dashboard_item"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>

    <record id="rule_rn_kpi_dashboard_bookmark_own" model="ir.rule">
        <field name="name">KPI Dashboard Bookmark own records</field>
        <field name="model_id" ref="model_rn_kpi_dashboard_bookmark"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_rn_dashboard_kpi_user'))]"/>
    </record>
</odoo>
