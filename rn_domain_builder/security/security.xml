<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record model="res.groups.privilege" id="res_groups_privilege_rn_domain_builder">
        <field name="name">ARMORA Domain Builder</field>
        <field name="category_id" ref="base.module_category_productivity"/>
    </record>
    <record id="group_rn_domain_builder_user" model="res.groups">
        <field name="name">User</field>
        <field name="privilege_id" ref="res_groups_privilege_rn_domain_builder"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="group_rn_domain_builder_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="privilege_id" ref="res_groups_privilege_rn_domain_builder"/>
        <field name="implied_ids" eval="[(4, ref('group_rn_domain_builder_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <record id="rule_rn_domain_dictionary_company" model="ir.rule">
        <field name="name">Domain Dictionary multi-company</field>
        <field name="model_id" ref="model_rn_domain_dictionary"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_rn_domain_history_company" model="ir.rule">
        <field name="name">Domain History multi-company</field>
        <field name="model_id" ref="model_rn_domain_history"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_rn_domain_history_user" model="ir.rule">
        <field name="name">Domain History own records</field>
        <field name="model_id" ref="model_rn_domain_history"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_rn_domain_builder_user'))]"/>
    </record>
</odoo>
