<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record model="res.groups.privilege" id="res_groups_privilege_rn_record_timeline">
        <field name="name">ARMORA Record Timeline</field>
        <field name="category_id" ref="base.module_category_productivity"/>
    </record>
    <record id="group_rn_timeline_user" model="res.groups">
        <field name="name">User</field>
        <field name="privilege_id" ref="res_groups_privilege_rn_record_timeline"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="group_rn_timeline_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="privilege_id" ref="res_groups_privilege_rn_record_timeline"/>
        <field name="implied_ids" eval="[(4, ref('group_rn_timeline_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <record id="rn_timeline_event_company_rule" model="ir.rule">
        <field name="name">Timeline events: multi-company</field>
        <field name="model_id" ref="model_rn_timeline_event"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_rn_timeline_user'))]"/>
    </record>
    <record id="rn_timeline_template_company_rule" model="ir.rule">
        <field name="name">Timeline templates: multi-company</field>
        <field name="model_id" ref="model_rn_timeline_template"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_rn_timeline_user'))]"/>
    </record>
</odoo>
