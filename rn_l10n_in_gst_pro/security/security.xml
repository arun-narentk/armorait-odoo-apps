<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record model="res.groups.privilege" id="res_groups_privilege_rn_gst">
        <field name="name">GST Compliance Pro</field>
        <field name="category_id" ref="base.module_category_accounting"/>
    </record>

    <record id="group_rn_gst_readonly" model="res.groups">
        <field name="name">Readonly</field>
        <field name="privilege_id" ref="res_groups_privilege_rn_gst"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_rn_gst_auditor" model="res.groups">
        <field name="name">Auditor</field>
        <field name="privilege_id" ref="res_groups_privilege_rn_gst"/>
        <field name="implied_ids" eval="[(4, ref('group_rn_gst_readonly'))]"/>
    </record>

    <record id="group_rn_gst_accountant" model="res.groups">
        <field name="name">Accountant</field>
        <field name="privilege_id" ref="res_groups_privilege_rn_gst"/>
        <field name="implied_ids" eval="[(4, ref('group_rn_gst_auditor'))]"/>
    </record>

    <record id="group_rn_gst_manager" model="res.groups">
        <field name="name">GST Manager</field>
        <field name="privilege_id" ref="res_groups_privilege_rn_gst"/>
        <field name="implied_ids" eval="[(4, ref('group_rn_gst_accountant'))]"/>
    </record>

    <record id="group_rn_gst_admin" model="res.groups">
        <field name="name">GST Administrator</field>
        <field name="privilege_id" ref="res_groups_privilege_rn_gst"/>
        <field name="implied_ids" eval="[(4, ref('group_rn_gst_manager'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <record id="rule_rn_gst_period_company" model="ir.rule">
        <field name="name">GST Period multi-company</field>
        <field name="model_id" ref="model_rn_gst_period"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_rn_gst_return_company" model="ir.rule">
        <field name="name">GST Return multi-company</field>
        <field name="model_id" ref="model_rn_gst_return"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_rn_gst_validation_company" model="ir.rule">
        <field name="name">GST Validation multi-company</field>
        <field name="model_id" ref="model_rn_gst_validation"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_rn_gst_reconciliation_company" model="ir.rule">
        <field name="name">GST Reconciliation multi-company</field>
        <field name="model_id" ref="model_rn_gst_reconciliation"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_rn_gst_settings_company" model="ir.rule">
        <field name="name">GST Settings multi-company</field>
        <field name="model_id" ref="model_rn_gst_settings"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

</odoo>
