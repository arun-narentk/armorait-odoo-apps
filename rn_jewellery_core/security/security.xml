<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record model="res.groups.privilege" id="res_groups_privilege_rn_jewellery">
        <field name="name">ARMORA Jewellery ERP</field>
        <field name="category_id" ref="base.module_category_services"/>
    </record>
    <record id="group_rn_jewellery_sales" model="res.groups">
        <field name="name">Sales</field>
        <field name="privilege_id" ref="res_groups_privilege_rn_jewellery"/>
    </record>
    <record id="group_rn_jewellery_production" model="res.groups">
        <field name="name">Production</field>
        <field name="privilege_id" ref="res_groups_privilege_rn_jewellery"/>
        <field name="implied_ids" eval="[(4, ref('group_rn_jewellery_sales'))]"/>
    </record>
    <record id="group_rn_jewellery_manager" model="res.groups">
        <field name="name">Jewellery Manager</field>
        <field name="privilege_id" ref="res_groups_privilege_rn_jewellery"/>
        <field name="implied_ids" eval="[(4, ref('group_rn_jewellery_production'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>
    <record id="rule_rn_jewellery_item_company" model="ir.rule">
        <field name="name">Jewellery Item multi-company</field>
        <field name="model_id" ref="model_rn_jewellery_item_spec"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_rn_jewellery_rate_company" model="ir.rule">
        <field name="name">Metal Rate multi-company</field>
        <field name="model_id" ref="model_rn_jewellery_metal_rate"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_rn_jewellery_job_card_company" model="ir.rule">
        <field name="name">Job Card multi-company</field>
        <field name="model_id" ref="model_rn_jewellery_job_card"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_rn_jewellery_order_company" model="ir.rule">
        <field name="name">Customer Order multi-company</field>
        <field name="model_id" ref="model_rn_jewellery_customer_order"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_rn_jewellery_settings_company" model="ir.rule">
        <field name="name">Jewellery Settings multi-company</field>
        <field name="model_id" ref="model_rn_jewellery_settings"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
