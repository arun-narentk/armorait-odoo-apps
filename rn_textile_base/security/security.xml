<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record model="res.groups.privilege" id="res_groups_privilege_rn_textile">
        <field name="name">ARMORA Textile Manufacturing</field>
        <field name="category_id" ref="base.module_category_manufacturing"/>
    </record>
    <record id="group_rn_textile_readonly" model="res.groups">
        <field name="name">Readonly</field>
        <field name="privilege_id" ref="res_groups_privilege_rn_textile"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="group_rn_textile_operator" model="res.groups">
        <field name="name">Shop Floor Operator</field>
        <field name="privilege_id" ref="res_groups_privilege_rn_textile"/>
        <field name="implied_ids" eval="[(4, ref('group_rn_textile_readonly'))]"/>
    </record>
    <record id="group_rn_textile_supervisor" model="res.groups">
        <field name="name">Production Supervisor</field>
        <field name="privilege_id" ref="res_groups_privilege_rn_textile"/>
        <field name="implied_ids" eval="[(4, ref('group_rn_textile_operator'))]"/>
    </record>
    <record id="group_rn_textile_manager" model="res.groups">
        <field name="name">Plant Manager</field>
        <field name="privilege_id" ref="res_groups_privilege_rn_textile"/>
        <field name="implied_ids" eval="[(4, ref('group_rn_textile_supervisor'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <record id="rule_rn_textile_factory_company" model="ir.rule">
        <field name="name">Textile Factory multi-company</field>
        <field name="model_id" ref="model_rn_textile_factory"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_rn_textile_department_company" model="ir.rule">
        <field name="name">Textile Department multi-company</field>
        <field name="model_id" ref="model_rn_textile_department"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_rn_textile_machine_company" model="ir.rule">
        <field name="name">Textile Machine multi-company</field>
        <field name="model_id" ref="model_rn_textile_machine"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_rn_textile_yarn_spec_company" model="ir.rule">
        <field name="name">Textile Yarn Spec multi-company</field>
        <field name="model_id" ref="model_rn_textile_yarn_spec"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_rn_textile_settings_company" model="ir.rule">
        <field name="name">Textile Settings multi-company</field>
        <field name="model_id" ref="model_rn_textile_settings"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_rn_textile_subscription_company" model="ir.rule">
        <field name="name">Textile Subscription multi-company</field>
        <field name="model_id" ref="model_rn_textile_subscription"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
