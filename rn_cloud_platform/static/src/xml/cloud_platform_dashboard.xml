<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve"><t t-name="rn_cloud_platform.Dashboard"><div class="o_rn_cloud_platform_dashboard o_action p-3"><h2>Cloud Platform</h2><div t-if="state.loading" class="text-muted">Loading cloud metrics...</div><div t-else=""><div class="row g-3 mb-4"><div class="col-md-4 col-lg-2"><div class="card p-3"><div class="text-muted small">Providers</div><h3 t-esc="state.data.providers"/></div></div><div class="col-md-4 col-lg-2"><div class="card p-3"><div class="text-muted small">Instances</div><h3 t-esc="state.data.instances"/></div></div><div class="col-md-4 col-lg-2"><div class="card p-3"><div class="text-muted small">Running</div><h3 t-esc="state.data.running_instances"/></div></div><div class="col-md-4 col-lg-2"><div class="card p-3"><div class="text-muted small">Backups</div><h3 t-esc="state.data.backups"/></div></div><div class="col-md-4 col-lg-2"><div class="card p-3"><div class="text-muted small">Open Recommendations</div><h3 t-esc="state.data.open_recommendations"/></div></div></div><div class="row g-3"><div class="col-lg-6"><div class="card p-3"><h5>Recent Instances</h5><div t-if="state.data.recent_instances.length" class="list-group list-group-flush"><div class="list-group-item" t-foreach="state.data.recent_instances" t-as="item" t-key="item.id"><strong t-esc="item.name"/> - <t t-esc="item.customer_name"/> - <t t-esc="item.status"/></div></div><div t-else="" class="text-muted">No instances yet.</div></div></div><div class="col-lg-6"><div class="card p-3"><h5>Recent Recommendations</h5><div t-if="state.data.recent_recommendations.length" class="list-group list-group-flush"><div class="list-group-item" t-foreach="state.data.recent_recommendations" t-as="item" t-key="item.id"><strong t-esc="item.title"/> - <t t-esc="item.severity"/><div class="small" t-esc="item.recommendation"/></div></div><div t-else="" class="text-muted">No recommendations yet.</div></div></div></div></div></div></t></templates>
