<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record model="res.groups.privilege" id="res_groups_privilege_rn_cloud_platform">
        <field name="name">Cloud Platform</field>
        <field name="category_id" ref="base.module_category_productivity"/>
    </record>
    <record id="group_rn_cloud_platform_user" model="res.groups">
        <field name="name">Cloud Platform User</field>
        <field name="privilege_id" ref="res_groups_privilege_rn_cloud_platform"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="group_rn_cloud_platform_manager" model="res.groups">
        <field name="name">Cloud Platform Manager</field>
        <field name="privilege_id" ref="res_groups_privilege_rn_cloud_platform"/>
        <field name="implied_ids" eval="[(4, ref('group_rn_cloud_platform_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>
    <record id="rule_rn_cloud_provider_company" model="ir.rule"><field name="name">Cloud provider multi-company</field><field name="model_id" ref="model_rn_cloud_provider"/><field name="domain_force">[('company_id', 'in', company_ids)]</field></record>
    <record id="rule_rn_cloud_instance_company" model="ir.rule"><field name="name">Cloud instance multi-company</field><field name="model_id" ref="model_rn_cloud_instance"/><field name="domain_force">[('company_id', 'in', company_ids)]</field></record>
    <record id="rule_rn_cloud_environment_company" model="ir.rule"><field name="name">Cloud environment multi-company</field><field name="model_id" ref="model_rn_cloud_environment"/><field name="domain_force">[('company_id', 'in', company_ids)]</field></record>
    <record id="rule_rn_cloud_backup_company" model="ir.rule"><field name="name">Cloud backup multi-company</field><field name="model_id" ref="model_rn_cloud_backup"/><field name="domain_force">[('company_id', 'in', company_ids)]</field></record>
    <record id="rule_rn_cloud_monitoring_company" model="ir.rule"><field name="name">Cloud monitoring multi-company</field><field name="model_id" ref="model_rn_cloud_monitoring"/><field name="domain_force">[('company_id', 'in', company_ids)]</field></record>
    <record id="rule_rn_cloud_recommendation_company" model="ir.rule"><field name="name">Cloud recommendation multi-company</field><field name="model_id" ref="model_rn_cloud_recommendation"/><field name="domain_force">[('company_id', 'in', company_ids)]</field></record>
</odoo>
