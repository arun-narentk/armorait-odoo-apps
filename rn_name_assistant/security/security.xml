<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record model="res.groups.privilege" id="res_groups_privilege_rn_name_assistant">
        <field name="name">ARMORA Name Assistant</field>
        <field name="category_id" ref="base.module_category_productivity"/>
    </record>
    <record id="group_rn_name_assistant_user" model="res.groups">
        <field name="name">User</field>
        <field name="privilege_id" ref="res_groups_privilege_rn_name_assistant"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="group_rn_name_assistant_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="privilege_id" ref="res_groups_privilege_rn_name_assistant"/>
        <field name="implied_ids" eval="[(4, ref('group_rn_name_assistant_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>
    <record id="rule_rn_name_template_company" model="ir.rule">
        <field name="name">Name Template multi-company</field>
        <field name="model_id" ref="model_rn_name_template"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_rn_name_abbreviation_company" model="ir.rule">
        <field name="name">Name Abbreviation multi-company</field>
        <field name="model_id" ref="model_rn_name_abbreviation"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
