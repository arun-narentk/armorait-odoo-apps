<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record model="res.groups.privilege" id="res_groups_privilege_rn_doc_platform">
        <field name="name">ARMORA Document Platform</field>
        <field name="category_id" ref="base.module_category_productivity"/>
    </record>
    <record id="group_rn_doc_platform_user" model="res.groups">
        <field name="name">Document User</field>
        <field name="privilege_id" ref="res_groups_privilege_rn_doc_platform"/>
    </record>
    <record id="group_rn_doc_platform_manager" model="res.groups">
        <field name="name">Document Manager</field>
        <field name="privilege_id" ref="res_groups_privilege_rn_doc_platform"/>
        <field name="implied_ids" eval="[(4, ref('group_rn_doc_platform_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <record id="rule_rn_doc_sign_request_company" model="ir.rule">
        <field name="name">Sign Request multi-company</field>
        <field name="model_id" ref="model_rn_doc_sign_request"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_rn_doc_sign_signer_company" model="ir.rule">
        <field name="name">Signer multi-company</field>
        <field name="model_id" ref="model_rn_doc_sign_signer"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_rn_doc_sign_audit_company" model="ir.rule">
        <field name="name">Sign Audit multi-company</field>
        <field name="model_id" ref="model_rn_doc_sign_audit"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_rn_doc_ai_analysis_company" model="ir.rule">
        <field name="name">AI Analysis multi-company</field>
        <field name="model_id" ref="model_rn_doc_ai_analysis"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_rn_doc_platform_settings_company" model="ir.rule">
        <field name="name">Platform Settings multi-company</field>
        <field name="model_id" ref="model_rn_doc_platform_settings"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
