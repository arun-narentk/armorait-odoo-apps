<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Pages (view_id points to template-created view) -->
        <record id="website_page_services" model="website.page">
            <field name="name">Services</field>
            <field name="url">/services</field>
            <field name="view_id" ref="website_armorait.page_services"/>
            <field name="is_published">True</field>
        </record>
        <record id="website_page_about" model="website.page">
            <field name="name">About</field>
            <field name="url">/about</field>
            <field name="view_id" ref="website_armorait.page_about"/>
            <field name="is_published">True</field>
        </record>
        <record id="website_page_contact" model="website.page">
            <field name="name">Contact</field>
            <field name="url">/contact</field>
            <field name="view_id" ref="website_armorait.page_contact"/>
            <field name="is_published">True</field>
        </record>
        <record id="website_page_erp_implementation" model="website.page">
            <field name="name">ERP Implementation</field>
            <field name="url">/erp-implementation</field>
            <field name="view_id" ref="website_armorait.page_erp_implementation"/>
            <field name="is_published">True</field>
        </record>
        <record id="website_page_odoo_customization" model="website.page">
            <field name="name">Odoo Customization</field>
            <field name="url">/odoo-customization</field>
            <field name="view_id" ref="website_armorait.page_odoo_customization"/>
            <field name="is_published">True</field>
        </record>

        <!-- Menus (parent: main menu) -->
        <record id="menu_services" model="website.menu">
            <field name="name">Services</field>
            <field name="url">/services</field>
            <field name="page_id" ref="website_page_services"/>
            <field name="parent_id" ref="website.main_menu"/>
            <field name="sequence" type="int">15</field>
        </record>
        <record id="menu_about" model="website.menu">
            <field name="name">About</field>
            <field name="url">/about</field>
            <field name="page_id" ref="website_page_about"/>
            <field name="parent_id" ref="website.main_menu"/>
            <field name="sequence" type="int">20</field>
        </record>
        <record id="menu_contact" model="website.menu">
            <field name="name">Contact</field>
            <field name="url">/contact</field>
            <field name="page_id" ref="website_page_contact"/>
            <field name="parent_id" ref="website.main_menu"/>
            <field name="sequence" type="int">25</field>
        </record>
        <record id="menu_erp_implementation" model="website.menu">
            <field name="name">ERP Implementation</field>
            <field name="url">/erp-implementation</field>
            <field name="page_id" ref="website_page_erp_implementation"/>
            <field name="parent_id" ref="website.main_menu"/>
            <field name="sequence" type="int">30</field>
        </record>
        <record id="menu_odoo_customization" model="website.menu">
            <field name="name">Odoo Customization</field>
            <field name="url">/odoo-customization</field>
            <field name="page_id" ref="website_page_odoo_customization"/>
            <field name="parent_id" ref="website.main_menu"/>
            <field name="sequence" type="int">35</field>
        </record>
    </data>
</odoo>
