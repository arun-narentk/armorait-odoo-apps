<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record model="res.groups.privilege" id="res_groups_privilege_rn_rental">
        <field name="name">ARMORA Rental</field>
        <field name="category_id" ref="base.module_category_sales"/>
    </record>
    <record id="group_rn_rental_readonly" model="res.groups">
        <field name="name">Readonly</field>
        <field name="privilege_id" ref="res_groups_privilege_rn_rental"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="group_rn_rental_user" model="res.groups">
        <field name="name">User</field>
        <field name="privilege_id" ref="res_groups_privilege_rn_rental"/>
        <field name="implied_ids" eval="[(4, ref('group_rn_rental_readonly'))]"/>
    </record>
    <record id="group_rn_rental_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="privilege_id" ref="res_groups_privilege_rn_rental"/>
        <field name="implied_ids" eval="[(4, ref('group_rn_rental_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>
    <record id="rule_rn_rental_asset_company" model="ir.rule">
        <field name="name">Rental Asset multi-company</field>
        <field name="model_id" ref="model_rn_rental_asset"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_rn_rental_booking_company" model="ir.rule">
        <field name="name">Rental Booking multi-company</field>
        <field name="model_id" ref="model_rn_rental_booking"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_rn_rental_category_company" model="ir.rule">
        <field name="name">Rental Category multi-company</field>
        <field name="model_id" ref="model_rn_rental_category"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_rn_rental_pricing_company" model="ir.rule">
        <field name="name">Rental Pricing multi-company</field>
        <field name="model_id" ref="model_rn_rental_pricing"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_rn_rental_settings_company" model="ir.rule">
        <field name="name">Rental Settings multi-company</field>
        <field name="model_id" ref="model_rn_rental_settings"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_rn_rental_subscription_company" model="ir.rule">
        <field name="name">Rental Subscription multi-company</field>
        <field name="model_id" ref="model_rn_rental_subscription"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
