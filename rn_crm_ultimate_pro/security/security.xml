<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record model="res.groups.privilege" id="res_groups_privilege_rn_crm">
        <field name="name">CRM Ultimate Pro</field>
        <field name="category_id" ref="base.module_category_sales"/>
    </record>
    <record id="group_rn_crm_readonly" model="res.groups">
        <field name="name">Readonly</field>
        <field name="privilege_id" ref="res_groups_privilege_rn_crm"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="group_rn_crm_salesperson" model="res.groups">
        <field name="name">Salesperson</field>
        <field name="privilege_id" ref="res_groups_privilege_rn_crm"/>
        <field name="implied_ids" eval="[(4, ref('group_rn_crm_readonly'))]"/>
    </record>
    <record id="group_rn_crm_manager" model="res.groups">
        <field name="name">CRM Manager</field>
        <field name="privilege_id" ref="res_groups_privilege_rn_crm"/>
        <field name="implied_ids" eval="[(4, ref('group_rn_crm_salesperson'))]"/>
    </record>
    <record id="group_rn_crm_admin" model="res.groups">
        <field name="name">CRM Administrator</field>
        <field name="privilege_id" ref="res_groups_privilege_rn_crm"/>
        <field name="implied_ids" eval="[(4, ref('group_rn_crm_manager'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>
    <record id="rule_rn_crm_score_history_company" model="ir.rule">
        <field name="name">Score History multi-company</field>
        <field name="model_id" ref="model_rn_crm_score_history"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_rn_crm_duplicate_batch_company" model="ir.rule">
        <field name="name">Duplicate Batch multi-company</field>
        <field name="model_id" ref="model_rn_crm_duplicate_batch"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_rn_crm_settings_company" model="ir.rule">
        <field name="name">CRM Settings multi-company</field>
        <field name="model_id" ref="model_rn_crm_settings"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_rn_crm_reminder_company" model="ir.rule">
        <field name="name">CRM Reminder multi-company</field>
        <field name="model_id" ref="model_rn_crm_reminder"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
