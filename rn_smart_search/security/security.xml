<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record model="res.groups.privilege" id="res_groups_privilege_rn_smart_search">
        <field name="name">ARMORA Smart Search</field>
        <field name="category_id" ref="base.module_category_productivity"/>
    </record>

    <record id="group_rn_smart_search_user" model="res.groups">
        <field name="name">User</field>
        <field name="privilege_id" ref="res_groups_privilege_rn_smart_search"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_rn_smart_search_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="privilege_id" ref="res_groups_privilege_rn_smart_search"/>
        <field name="implied_ids" eval="[(4, ref('group_rn_smart_search_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <record id="rule_rn_search_history_user" model="ir.rule">
        <field name="name">Smart Search history: own entries</field>
        <field name="model_id" ref="model_rn_search_history"/>
        <field name="groups" eval="[(4, ref('group_rn_smart_search_user'))]"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
    </record>
</odoo>
