<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record model="res.groups.privilege" id="res_groups_privilege_rn_customer_engagement_platform">
        <field name="name">Customer Engagement Platform</field>
        <field name="category_id" ref="base.module_category_website"/>
    </record>

    <record id="group_rn_customer_engagement_user" model="res.groups">
        <field name="name">Customer Engagement User</field>
        <field name="privilege_id" ref="res_groups_privilege_rn_customer_engagement_platform"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_rn_customer_engagement_manager" model="res.groups">
        <field name="name">Customer Engagement Manager</field>
        <field name="privilege_id" ref="res_groups_privilege_rn_customer_engagement_platform"/>
        <field name="implied_ids" eval="[(4, ref('group_rn_customer_engagement_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <record id="rule_rn_customer_engagement_channel_company" model="ir.rule">
        <field name="name">Customer engagement channel multi-company</field>
        <field name="model_id" ref="model_rn_customer_engagement_channel"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_rn_customer_engagement_session_company" model="ir.rule">
        <field name="name">Customer engagement session multi-company</field>
        <field name="model_id" ref="model_rn_customer_engagement_session"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_rn_customer_engagement_knowledge_company" model="ir.rule">
        <field name="name">Customer engagement knowledge multi-company</field>
        <field name="model_id" ref="model_rn_customer_engagement_knowledge"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_rn_customer_engagement_conversation_company" model="ir.rule">
        <field name="name">Customer engagement conversation multi-company</field>
        <field name="model_id" ref="model_rn_customer_engagement_conversation"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_rn_customer_engagement_line_company" model="ir.rule">
        <field name="name">Customer engagement line multi-company</field>
        <field name="model_id" ref="model_rn_customer_engagement_line"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_rn_customer_engagement_escalation_company" model="ir.rule">
        <field name="name">Customer engagement escalation multi-company</field>
        <field name="model_id" ref="model_rn_customer_engagement_escalation"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
