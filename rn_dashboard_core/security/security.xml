<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record model="res.groups.privilege" id="res_groups_privilege_rn_dashboard">
        <field name="name">ARMORA Dashboard</field>
        <field name="category_id" ref="base.module_category_services"/>
    </record>
    <record id="group_rn_dashboard_readonly" model="res.groups">
        <field name="name">Readonly</field>
        <field name="privilege_id" ref="res_groups_privilege_rn_dashboard"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="group_rn_dashboard_user" model="res.groups">
        <field name="name">User</field>
        <field name="privilege_id" ref="res_groups_privilege_rn_dashboard"/>
        <field name="implied_ids" eval="[(4, ref('group_rn_dashboard_readonly'))]"/>
    </record>
    <record id="group_rn_dashboard_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="privilege_id" ref="res_groups_privilege_rn_dashboard"/>
        <field name="implied_ids" eval="[(4, ref('group_rn_dashboard_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <record id="rule_rn_dashboard_company" model="ir.rule">
        <field name="name">Dashboard multi-company</field>
        <field name="model_id" ref="model_rn_dashboard"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_rn_dashboard_widget_company" model="ir.rule">
        <field name="name">Dashboard Widget multi-company</field>
        <field name="model_id" ref="model_rn_dashboard_widget"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_rn_dashboard_filter_company" model="ir.rule">
        <field name="name">Dashboard Filter multi-company</field>
        <field name="model_id" ref="model_rn_dashboard_filter"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_rn_dashboard_alert_rule_company" model="ir.rule">
        <field name="name">Dashboard Alert Rule multi-company</field>
        <field name="model_id" ref="model_rn_dashboard_alert_rule"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_rn_dashboard_alert_company" model="ir.rule">
        <field name="name">Dashboard Alert multi-company</field>
        <field name="model_id" ref="model_rn_dashboard_alert"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_rn_dashboard_kpi_company" model="ir.rule">
        <field name="name">Dashboard KPI multi-company</field>
        <field name="model_id" ref="model_rn_dashboard_kpi"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_rn_dashboard_kpi_snapshot_company" model="ir.rule">
        <field name="name">Dashboard KPI Snapshot multi-company</field>
        <field name="model_id" ref="model_rn_dashboard_kpi_snapshot"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_rn_dashboard_settings_company" model="ir.rule">
        <field name="name">Dashboard Settings multi-company</field>
        <field name="model_id" ref="model_rn_dashboard_settings"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_rn_dashboard_subscription_company" model="ir.rule">
        <field name="name">Dashboard Subscription multi-company</field>
        <field name="model_id" ref="model_rn_dashboard_subscription"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
