<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record model="res.groups.privilege" id="res_groups_privilege_rn_bookmarks">
        <field name="name">ARMORA Bookmarks</field>
        <field name="category_id" ref="base.module_category_productivity"/>
    </record>

    <record id="group_rn_bookmarks_user" model="res.groups">
        <field name="name">User</field>
        <field name="privilege_id" ref="res_groups_privilege_rn_bookmarks"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_rn_bookmarks_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="privilege_id" ref="res_groups_privilege_rn_bookmarks"/>
        <field name="implied_ids" eval="[(4, ref('group_rn_bookmarks_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <record id="rule_rn_bookmark_user" model="ir.rule">
        <field name="name">Bookmark own records</field>
        <field name="model_id" ref="model_rn_bookmark"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_rn_bookmarks_user'))]"/>
    </record>

    <record id="rule_rn_bookmark_folder_user" model="ir.rule">
        <field name="name">Bookmark Folder own records</field>
        <field name="model_id" ref="model_rn_bookmark_folder"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_rn_bookmarks_user'))]"/>
    </record>

    <record id="rule_rn_bookmark_tag_user" model="ir.rule">
        <field name="name">Bookmark Tag own records</field>
        <field name="model_id" ref="model_rn_bookmark_tag"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_rn_bookmarks_user'))]"/>
    </record>

    <record id="rule_rn_bookmark_folder_company" model="ir.rule">
        <field name="name">Bookmark Folder multi-company</field>
        <field name="model_id" ref="model_rn_bookmark_folder"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="rule_rn_bookmark_company" model="ir.rule">
        <field name="name">Bookmark multi-company</field>
        <field name="model_id" ref="model_rn_bookmark"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
