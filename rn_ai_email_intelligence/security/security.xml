<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record model="res.groups.privilege" id="res_groups_privilege_rn_ai_email">
        <field name="name">ARMORA AI Email Intelligence</field>
        <field name="category_id" ref="base.module_category_productivity"/>
    </record>
    <record id="group_rn_ai_email_user" model="res.groups">
        <field name="name">AI Email User</field>
        <field name="privilege_id" ref="res_groups_privilege_rn_ai_email"/>
    </record>
    <record id="group_rn_ai_email_manager" model="res.groups">
        <field name="name">AI Email Manager</field>
        <field name="privilege_id" ref="res_groups_privilege_rn_ai_email"/>
        <field name="implied_ids" eval="[(4, ref('group_rn_ai_email_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>
    <record id="rule_rn_ai_email_draft_company" model="ir.rule">
        <field name="name">AI Email Draft multi-company</field>
        <field name="model_id" ref="model_rn_ai_email_draft"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_rn_ai_email_template_company" model="ir.rule">
        <field name="name">AI Email Template multi-company</field>
        <field name="model_id" ref="model_rn_ai_email_template"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_rn_ai_email_settings_company" model="ir.rule">
        <field name="name">AI Email Settings multi-company</field>
        <field name="model_id" ref="model_rn_ai_email_settings"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
