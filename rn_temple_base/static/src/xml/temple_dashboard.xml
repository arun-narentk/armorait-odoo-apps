<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="rn_temple_base.TempleDashboard">
        <div class="o_rn_temple_dashboard p-4">
            <h2>Temple Operations</h2>
            <div class="row g-3 mt-2">
                <div class="col-md-2" t-foreach="state.cards" t-as="card" t-key="card.key">
                    <div class="card shadow-sm">
                        <div class="card-body text-center">
                            <div class="fs-4 fw-bold" t-esc="card.value"/>
                            <div class="text-muted" t-esc="card.label"/>
                        </div>
                    </div>
                </div>
            </div>
            <h4 class="mt-4">Upcoming Festivals</h4>
            <ul class="list-group">
                <li class="list-group-item" t-foreach="state.festivals" t-as="fest" t-key="fest.id">
                    <strong t-esc="fest.name"/> -
                    <span t-esc="fest.date_start"/>
                    <span t-if="fest.temple"> (<t t-esc="fest.temple"/>)</span>
                </li>
            </ul>
        </div>
    </t>
</templates>
