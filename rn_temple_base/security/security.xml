<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record model="res.groups.privilege" id="res_groups_privilege_rn_temple">
        <field name="name">ARMORA Temple Management</field>
        <field name="category_id" ref="base.module_category_services"/>
    </record>
    <record id="group_rn_temple_readonly" model="res.groups">
        <field name="name">Readonly</field>
        <field name="privilege_id" ref="res_groups_privilege_rn_temple"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="group_rn_temple_counter" model="res.groups">
        <field name="name">Counter Staff</field>
        <field name="privilege_id" ref="res_groups_privilege_rn_temple"/>
        <field name="implied_ids" eval="[(4, ref('group_rn_temple_readonly'))]"/>
    </record>
    <record id="group_rn_temple_office" model="res.groups">
        <field name="name">Office Staff</field>
        <field name="privilege_id" ref="res_groups_privilege_rn_temple"/>
        <field name="implied_ids" eval="[(4, ref('group_rn_temple_counter'))]"/>
    </record>
    <record id="group_rn_temple_manager" model="res.groups">
        <field name="name">Trust Manager</field>
        <field name="privilege_id" ref="res_groups_privilege_rn_temple"/>
        <field name="implied_ids" eval="[(4, ref('group_rn_temple_office'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <record id="rule_rn_temple_temple_company" model="ir.rule">
        <field name="name">Temple multi-company</field>
        <field name="model_id" ref="model_rn_temple_temple"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_rn_temple_branch_company" model="ir.rule">
        <field name="name">Temple Branch multi-company</field>
        <field name="model_id" ref="model_rn_temple_branch"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_rn_temple_trustee_company" model="ir.rule">
        <field name="name">Temple Trustee multi-company</field>
        <field name="model_id" ref="model_rn_temple_trustee"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_rn_temple_priest_company" model="ir.rule">
        <field name="name">Temple Priest multi-company</field>
        <field name="model_id" ref="model_rn_temple_priest"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_rn_temple_department_company" model="ir.rule">
        <field name="name">Temple Department multi-company</field>
        <field name="model_id" ref="model_rn_temple_department"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_rn_temple_timing_company" model="ir.rule">
        <field name="name">Temple Timing multi-company</field>
        <field name="model_id" ref="model_rn_temple_timing"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_rn_temple_festival_company" model="ir.rule">
        <field name="name">Temple Festival multi-company</field>
        <field name="model_id" ref="model_rn_temple_festival"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_rn_temple_settings_company" model="ir.rule">
        <field name="name">Temple Settings multi-company</field>
        <field name="model_id" ref="model_rn_temple_settings"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_rn_temple_subscription_company" model="ir.rule">
        <field name="name">Temple Subscription multi-company</field>
        <field name="model_id" ref="model_rn_temple_subscription"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
