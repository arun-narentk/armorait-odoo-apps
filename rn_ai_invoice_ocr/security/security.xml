<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record model="res.groups.privilege" id="res_groups_privilege_rn_invoice_ocr">
        <field name="name">ARMORA AI Invoice OCR</field>
        <field name="category_id" ref="base.module_category_accounting"/>
    </record>
    <record id="group_rn_invoice_ocr_user" model="res.groups">
        <field name="name">OCR User</field>
        <field name="privilege_id" ref="res_groups_privilege_rn_invoice_ocr"/>
        <field name="implied_ids" eval="[(4, ref('account.group_account_invoice'))]"/>
    </record>
    <record id="group_rn_invoice_ocr_manager" model="res.groups">
        <field name="name">OCR Manager</field>
        <field name="privilege_id" ref="res_groups_privilege_rn_invoice_ocr"/>
        <field name="implied_ids" eval="[(4, ref('group_rn_invoice_ocr_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <record id="rule_rn_ai_invoice_scan_company" model="ir.rule">
        <field name="name">Invoice Scan multi-company</field>
        <field name="model_id" ref="model_rn_ai_invoice_scan"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_rn_ai_invoice_scan_line_company" model="ir.rule">
        <field name="name">Invoice Scan Line multi-company</field>
        <field name="model_id" ref="model_rn_ai_invoice_scan_line"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_rn_ai_invoice_vendor_mapping_company" model="ir.rule">
        <field name="name">Vendor Mapping multi-company</field>
        <field name="model_id" ref="model_rn_ai_invoice_vendor_mapping"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_rn_ai_invoice_product_mapping_company" model="ir.rule">
        <field name="name">Product Mapping multi-company</field>
        <field name="model_id" ref="model_rn_ai_invoice_product_mapping"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_rn_ai_invoice_ocr_settings_company" model="ir.rule">
        <field name="name">OCR Settings multi-company</field>
        <field name="model_id" ref="model_rn_ai_invoice_ocr_settings"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_rn_ai_invoice_ocr_subscription_company" model="ir.rule">
        <field name="name">OCR Subscription multi-company</field>
        <field name="model_id" ref="model_rn_ai_invoice_ocr_subscription"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
